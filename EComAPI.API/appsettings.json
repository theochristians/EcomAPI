{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": [
            "https://thrifties.app",
            "https://www.thrifties.app",
            "http://localhost:5173",
            "http://localhost:3000"
        ]
    },
    "ConnectionStrings": {
        "SQLServerThrifted":  "<FROM_VG_CONNECTIONSTRINGS__SQLSERVERTHRIFTED>"
    },
    "JwtSettings": {
        "Secret": "<FROM_VG_JWTSETTINGS__SECRET>",
        "Issuer": "EComAPI",
        "Audience": "EComAPIClients",
        "ExpiryMinutes": 120
    },
    "TokenBlacklist": {
        "FallbackMinutes": 15,
        "MaxMinutes": 120,
        "CleanupIntervalMinutes": 60
    },
    "RateLimiting": {
        "RejectionMessage": "Too many requests. Please try again later.",
        "AuthRegister": {
            "PermitLimit": 5,
            "WindowMinutes": 10
        },
        "AuthLogin": {
            "PermitLimit": 10,
            "WindowMinutes": 1
        },
        "EmailVerifySend": {
            "PermitLimit": 3,
            "WindowMinutes": 10
        },
        "EmailVerifyCheck": {
            "PermitLimit": 15,
            "WindowMinutes": 10
        },
        "UploadSas": {
            "PermitLimit": 30,
            "WindowMinutes": 5
        },
        "UploadConfirm": {
            "PermitLimit": 60,
            "WindowMinutes": 5
        }
    },
    "Redis":  {
                  "Enabled":  true,
                  "Url":  "<FROM_VG_REDIS__URL>",
                  "Token":  "<FROM_VG_REDIS__TOKEN>",
                  "InstanceName":  "<FROM_VG_REDIS__INSTANCENAME>"
              },
    "Email":  {
                  "Enabled":  true,
                  "SmtpHost":  "<FROM_VG_EMAIL__SMTPHOST>",
                  "SmtpPort":  587,
                  "SmtpUsername":  "<FROM_VG_EMAIL__SMTPUSERNAME>",
                  "SmtpPassword":  "<FROM_VG_EMAIL__SMTPPASSWORD>",
                  "FromEmail":  "<FROM_VG_EMAIL__FROMEMAIL>",
                  "FromName":  "<FROM_VG_EMAIL__FROMNAME>",
                  "BrandName":  "<FROM_VG_EMAIL__BRANDNAME>",
                  "BrandDomain":  "<FROM_VG_EMAIL__BRANDDOMAIN>",
                  "LogoUrl":  "<FROM_VG_EMAIL__LOGOURL>",
                  "EnableSsl":  true
    },
    "AzureBlobStorage": {
        "Enabled": true,
        "AccountName": "<FROM_VG_AZUREBLOBSTORAGE__ACCOUNTNAME>",
        "ContainerName": "<FROM_VG_AZUREBLOBSTORAGE__CONTAINERNAME>",
        "TenantId": "<FROM_VG_AZUREBLOBSTORAGE__TENANTID>",
        "ClientId": "<FROM_VG_AZUREBLOBSTORAGE__CLIENTID>",
        "ClientSecret": "<FROM_VG_AZUREBLOBSTORAGE__CLIENTSECRET>"
    }
}
