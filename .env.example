# Core
ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__SQLServerThrifted=Server=.;Database=ThriftedDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# JWT
JwtSettings__Secret=CHANGE_ME_WITH_STRONG_RANDOM_SECRET
JwtSettings__Issuer=EComAPI
JwtSettings__Audience=EComAPIClients
JwtSettings__ExpiryMinutes=120

# Token Blacklist
TokenBlacklist__FallbackMinutes=15
TokenBlacklist__MaxMinutes=120
TokenBlacklist__CleanupIntervalMinutes=60

# Rate Limiting
RateLimiting__RejectionMessage=Too many requests. Please try again later.
RateLimiting__AuthRegister__PermitLimit=5
RateLimiting__AuthRegister__WindowMinutes=10
RateLimiting__AuthLogin__PermitLimit=10
RateLimiting__AuthLogin__WindowMinutes=1
RateLimiting__EmailVerifySend__PermitLimit=3
RateLimiting__EmailVerifySend__WindowMinutes=10
RateLimiting__EmailVerifyCheck__PermitLimit=15
RateLimiting__EmailVerifyCheck__WindowMinutes=10
RateLimiting__UploadSas__PermitLimit=30
RateLimiting__UploadSas__WindowMinutes=5
RateLimiting__UploadConfirm__PermitLimit=60
RateLimiting__UploadConfirm__WindowMinutes=5

# CORS
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000

# Redis (optional)
Redis__Enabled=false
Redis__Url=
Redis__Token=
Redis__InstanceName=ecomapi:

# Email (optional)
Email__Enabled=false
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__FromEmail=
Email__FromName=EComAPI
Email__BrandName=Thrifties
Email__BrandDomain=thrifties.app
Email__LogoUrl=
Email__EnableSsl=true

# Azure Blob Storage (optional)
AzureBlobStorage__Enabled=false
AzureBlobStorage__AccountName=
AzureBlobStorage__ContainerName=
AzureBlobStorage__TenantId=
AzureBlobStorage__ClientId=
AzureBlobStorage__ClientSecret=

# Alias env vars supported by current code (for Azure/Redis/Email):
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# REDIS_URL=
# REDIS_TOKEN=
# EMAIL_ENABLED=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_EMAIL=
# EMAIL_FROM_NAME=
# EMAIL_BRAND_NAME=
# EMAIL_BRAND_DOMAIN=
# EMAIL_LOGO_URL=
# EMAIL_ENABLE_SSL=
